#!/usr/bin/env python3
"""Launcher. Runs amdgraph straight from a checkout, with no install step and
no PYTHONPATH to remember -- symlink this anywhere on your PATH and it still
finds its own package.

The program itself is src/amdgraph/; start at its __init__.py, which maps the
layers.
"""

import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "src"))

from amdgraph.__main__ import main            # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
