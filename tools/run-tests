#!/usr/bin/env bash
# Everything that can be checked without hardware.
#
# The layering check is not a unittest because it is also a standalone tool, so
# it runs first and its exit status counts.
set -u
cd "$(dirname "$(dirname "$(readlink -f "$0")")")" || exit 1

rc=0
echo "== layering =="
python3 tools/check-layers.py || rc=1

echo
echo "== unit tests =="
QT_QPA_PLATFORM=offscreen python3 -m unittest discover -s tests -t . "$@" || rc=1

echo
echo "== help text (catches an import-time break in the launcher) =="
./amdgraph --help >/dev/null && echo "ok" || rc=1

exit $rc
